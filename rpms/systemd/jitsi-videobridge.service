[Unit]
Description=Jitsi Videobridge
After=network-online.target
Wants=network-online.target

[Service]
SuccessExitStatus=143
RestartPreventExitStatus=78
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=-/etc/jitsi/videobridge/config
Environment=LOGFILE=/var/log/jitsi/jvb.log
User=jvb
Group=jvb
RuntimeDirectory=jitsi-videobridge
RuntimeDirectoryMode=0750
TasksMax=65000
LimitNPROC=65000
LimitNOFILE=65000
WorkingDirectory=/usr/share/jitsi-videobridge
ExecStart=/bin/bash -c 'exec /usr/share/jitsi-videobridge/jvb.sh ${JVB_OPTS} >> ${LOGFILE} 2>&1'
ExecStartPost=/bin/bash -c 'echo $MAINPID > /run/jitsi-videobridge/jitsi-videobridge.pid'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
